<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ap.controller.AdopcionController">

    <top>
        <VBox spacing="5" style="-fx-background-color: #2E7D32;">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="ADOPTA UNA MASCOTA" />
            <Label style="-fx-text-fill: white; -fx-font-size: 14px;" text="Sistema de gestión de adopción de animales" />
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <GridPane hgap="10" vgap="10">
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombre" promptText="Nombre del animal" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Especie:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbEspecie" promptText="Seleccione especie" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Raza:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtRaza" promptText="Raza" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="txtEdad" promptText="Edad en años" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <ComboBox fx:id="cmbEstado" promptText="Seleccione estado" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>

            <HBox spacing="10">
                <Button onAction="#registrar" text="Registrar" />
                <Button onAction="#modificar" text="Modificar" />
                <Button onAction="#eliminar" text="Eliminar" />
                <Button onAction="#cambiarEstado" text="Cambiar estado" />
                <Button onAction="#limpiar" text="Limpiar" />
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre, especie o raza" HBox.hgrow="ALWAYS" />
                <Button onAction="#buscar" text="Buscar" />
                <Button onAction="#mostrarTodos" text="Mostrar todos" />
            </HBox>

            <TableView fx:id="tablaAnimales" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
                    <TableColumn fx:id="colEspecie" prefWidth="120" text="Especie" />
                    <TableColumn fx:id="colRaza" prefWidth="150" text="Raza" />
                    <TableColumn fx:id="colEdad" prefWidth="80" text="Edad" />
                    <TableColumn fx:id="colEstado" prefWidth="150" text="Estado" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>